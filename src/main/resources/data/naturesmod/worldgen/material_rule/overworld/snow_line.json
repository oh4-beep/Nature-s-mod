{
  "type": "minecraft:condition",
  "if_true": {
    "type": "minecraft:y_above",
    "anchor": {
      "absolute": 335
    },
    "surface_depth_multiplier": 4,
    "add_stone_depth": false
  },
  "then_run": {
    "type": "minecraft:condition",
    "if_true": "minecraft:not_underwater",
    "then_run": {
      "type": "minecraft:sequence",
      "sequence": [
        {
          "type": "minecraft:condition",
          "if_true": {
            "type": "minecraft:steep"
          },
          "then_run": {
            "type": "minecraft:condition",
            "if_true": "minecraft:under_floor",
            "then_run": {
              "type": "minecraft:sequence",
              "sequence": [
                {
                  "type": "minecraft:condition",
                  "if_true": {
                    "type": "minecraft:noise_threshold",
                    "noise": "minecraft:packed_ice",
                    "min_threshold": 0.0,
                    "max_threshold": 0.15
                  },
                  "then_run": {
                    "type": "minecraft:block",
                    "result_state": "minecraft:packed_ice"
                  }
                },
                {
                  "type": "minecraft:block",
                  "result_state": "minecraft:stone"
                }
              ]
            }
          }
        },
        {
          "type": "minecraft:condition",
          "if_true": "minecraft:under_floor",
          "then_run": {
            "type": "minecraft:block",
            "result_state": "minecraft:snow_block"
          }
        }
      ]
    }
  }
}
